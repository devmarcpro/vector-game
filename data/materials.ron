 (id:"glace_dure", yields:[("water_ice",8.0,0.95), ("ammonia",1.0,0.2)], under:"glace", name:"Glace dure", kind:"wall", glyphs:"#%", color:0x00A0D0F0, pattern:"lisse", hardness:0.5,
  ground_of:[("calotte",5.0), ("toundra",1.5), ("montagne",1.5)],
  text:"Glace de millénaires, dure comme la pierre."),
 (id:"granit", yields:[("silica",3.0,0.8), ("aluminium",1.5,0.5), ("lithium",0.3,0.15), ("uranium",0.15,0.08), ("thorium",0.1,0.06)], under:"roche_nue", name:"Granit", kind:"wall", glyphs:"#", color:0x00707078, pattern:"bruit", hardness:0.9,
  ground_of:[("montagne",3.0), ("massif",2.0), ("taiga",1.0)],
