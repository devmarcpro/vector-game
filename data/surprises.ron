// Surprises: rare events born of the crossing of systems (war, cartels, epidemics, colonies,
// relations, anomalies, contracts...). Each one is a rule: `when` lists conditions on the world
// around the ship (all must hold), `weight` is its relative frequency, `cooldown` the days before
// it can come again, `effects` apply at once, `choices` (at most three, with `window` days to
// answer) are offered to the player. tag: a tag of the news feed. Text placeholders: {here}
// the people of the territory, {ally} and {rival} one of its allies and enemies, {place} the
// system. Targets: Here Ally Rival Contact Civ Faction(id) Cartel(id) Company(id).
// Effects: Credits(cr) Rel(target, delta) Bond(a, b, weight, days) Shock(resource or "cat:x",
// multiplier, days) Cargo(resource, kg: negative takes what the hold has) Morale(d) Contract(
// resource, kg, reward x price) Research(points) ColonyHappiness(d).
[
 (id:"penurie_guerre_metaux", name:"Pénurie organisée", tag:"GUERRE", weight:1.0, cooldown:60.0,
  when:[AtWar, CartelHere("metaux_unis")],
  effects:[Shock("cat:metal", 1.5, 25.0), Rel(Cartel("metaux_unis"), -0.04)],
  text:"En pleine guerre, le Consortium des Métaux unis retient ses stocks près de {place} : le métal devient introuvable."),
 (id:"penurie_famine_vivres", name:"Les silos se ferment", tag:"BOURSE", weight:1.0, cooldown:60.0,
  when:[WorldEvent("famine"), CartelHere("compagnie_vivres")],
  effects:[Shock("food", 1.5, 20.0), Shock("medicine", 1.25, 20.0), Rel(Cartel("compagnie_vivres"), -0.05)],
  text:"La famine rend la Compagnie des Vivres avare : les rations atteignent des sommets autour de {place}."),
 (id:"guerre_des_prix", name:"Guerre des prix", tag:"ENTREPRISES", weight:0.8, cooldown:90.0,
  when:[CartelHere("pacte_atomique"), CartelHere("ordre_helios")],
  effects:[Shock("fuel", 0.75, 20.0), Shock("uranium", 0.8, 20.0), Bond(Cartel("pacte_atomique"), Cartel("ordre_helios"), -1.0, 40.0)],
  text:"Le Pacte atomique et l'Ordre d'Hélios se disputent la région : le combustible se brade, le temps d'une guerre de tarifs."),
 (id:"prime_de_siege", name:"Prime de fin d'exercice", tag:"ENTREPRISES", weight:0.8, cooldown:45.0,
  when:[Seat("fraternite_eau"), CartelHere("fraternite_eau")],
  effects:[Credits(1800.0), Rel(Cartel("fraternite_eau"), 0.04)],
  text:"La Fraternité de l'Eau verse une prime exceptionnelle à ses membres autour de {place}."),
 (id:"enquete_discrete", name:"Une enquête qui approche", tag:"CRIME", weight:0.7, cooldown:80.0,
  when:[Seat("cercle_or"), Rel(Here, Lt, 0.0)],
  choices:[
   (label:"Payer discrètement", result:"Un fonctionnaire oublie votre dossier ; {here} vous en sait gré.", effects:[Credits(-1500.0), Rel(Here, 0.05)]),
   (label:"Tout nier", result:"Le Cercle de l'Or vous soutient, mais {here} note votre arrogance.", effects:[Rel(Here, -0.08), Rel(Cartel("cercle_or"), 0.06)]),
  ], window:10.0,
  text:"Des enquêteurs de {here} s'intéressent aux comptes du Cercle de l'Or, donc aux vôtres."),
 (id:"quarantaine_colonie", name:"Quarantaine", tag:"COLONIES", weight:1.2, cooldown:40.0,
  when:[Epidemic(30.0), ColonyNear(30.0)],
  effects:[Shock("medicine", 1.8, 20.0)],
  choices:[
   (label:"Livrer des médicaments", result:"Vos soins arrivent à temps : la colonie respire et {here} le sait.", effects:[Cargo("medicine", -100.0), ColonyHappiness(0.1), Rel(Here, 0.04)]),
   (label:"Boucler le port", result:"La quarantaine tient, au prix de la grogne des colons.", effects:[ColonyHappiness(-0.08), Rel(Here, 0.02)]),
  ], window:12.0,
  text:"Une épidémie frappe vos colons : les ports voisins imposent une quarantaine et les médicaments s'arrachent."),
 (id:"epidemie_contrat", name:"Appel d'urgence", tag:"COLONIES", weight:1.0, cooldown:45.0,
  when:[WorldEvent("epidemie"), Docked],
  effects:[Contract("medicine", 400.0, 2.0)],
  text:"L'épidémie qui court la région pousse la station de {place} à proposer un contrat d'urgence pour des médicaments."),
 (id:"cadeau_allie", name:"Un présent diplomatique", tag:"POLITIQUE", weight:1.0, cooldown:90.0,
  when:[Rel(Here, Gt, 0.6), Docked],
  effects:[Credits(2500.0), Rel(Here, 0.02)],
  text:"{here} vous fait porter une bourse en gage d'amitié : on parle de vous comme d'un allié sûr."),
 (id:"invitation_gala", name:"Invitation officielle", tag:"POLITIQUE", weight:1.0, cooldown:90.0,
  when:[Rel(Here, Gt, 0.5), Docked],
  choices:[
   (label:"Accepter l'invitation", result:"La soirée est fastueuse : {here} vous compte parmi ses proches, {rival} grince des dents.", effects:[Credits(-500.0), Rel(Here, 0.1), Rel(Rival, -0.05), Morale(0.1)]),
   (label:"Décliner poliment", result:"On ne vous en tient pas rigueur, mais on s'en souvient.", effects:[Rel(Here, -0.02)]),
  ], window:8.0,
  text:"{here} vous invite à une réception officielle à {place}."),
 (id:"mefiance_des_liens", name:"Des liens suspects", tag:"POLITIQUE", weight:1.0, cooldown:60.0,
  when:[Rel(Here, Lt, -0.3), Rel(Rival, Gt, 0.3)],
  effects:[Rel(Here, -0.05), Bond(Here, Rival, -1.0, 45.0)],
  text:"{here} s'inquiète de votre amitié avec {rival} : les deux camps se durcissent."),
 (id:"front_commun", name:"Front commun", tag:"POLITIQUE", weight:0.9, cooldown:80.0,
  when:[Rel(Here, Gt, 0.3), Rel(Ally, Gt, 0.2)],
  effects:[Bond(Here, Ally, 1.0, 90.0), Rel(Ally, 0.04)],
  text:"{here} et {ally} scellent un pacte dont vous êtes l'ami commun : ses bénéfices vous reviennent."),
 (id:"embargo_froid", name:"Les ports se ferment", tag:"POLITIQUE", weight:0.8, cooldown:60.0,
  when:[WorldEvent("embargo"), Rel(Here, Lt, -0.2)],
  effects:[Shock("cat:ammo", 1.4, 20.0), Rel(Here, -0.03)],
  text:"L'embargo se durcit contre ceux que {here} n'aime pas : les cargaisons d'armes vous échappent."),
 (id:"colis_du_contact", name:"Un colis à passer", tag:"CRIME", weight:1.0, cooldown:50.0,
  when:[Rel(Contact, Gt, 0.4), Docked],
  choices:[
   (label:"Prendre le colis", result:"Le colis tient dans la soute ; votre contact vous doit une faveur, {here} n'en saura rien.", effects:[Cargo("luxury_goods", 200.0), Rel(Contact, 0.1), Rel(Here, -0.05)]),
   (label:"Refuser", result:"Votre contact hausse les épaules.", effects:[Rel(Contact, -0.03)]),
  ], window:6.0,
  text:"Votre contact de {place} vous demande un service discret : un colis à emporter."),
 (id:"contact_prevenant", name:"Un ami dans l'ombre", tag:"CRIME", weight:1.0, cooldown:50.0,
  when:[Rel(Contact, Gt, 0.5), Wanted],
  effects:[Rel(Contact, 0.03), Rel(Here, 0.01)],
  text:"Votre contact vous glisse l'horaire des patrouilles de {here} : vous respirez un peu mieux."),
 (id:"prime_sur_votre_tete", name:"Une prime sur votre tête", tag:"CRIME", weight:1.0, cooldown:60.0,
  when:[Wanted, Docked],
  choices:[
   (label:"Payer pour la faire retirer", result:"L'avis est retiré ; {here} a pris l'argent.", effects:[Credits(-2000.0), Rel(Here, 0.1)]),
   (label:"Courir le risque", result:"L'équipage dort mal en sachant les chasseurs de primes à vos trousses.", effects:[Morale(-0.06)]),
  ], window:8.0,
  text:"Les chasseurs de primes de {place} ont votre nom sur leur liste."),
 (id:"releves_pour_contrat", name:"Un institut s'intéresse à vos relevés", tag:"SCIENCE", weight:1.2, cooldown:45.0,
  when:[Anomaly, Docked],
  effects:[Contract("research_data", 300.0, 2.2)],
  text:"Un phénomène près de {place} intrigue un institut : il propose un contrat pour des relevés de données."),
 (id:"signal_de_la_balise", name:"Le signal répond", tag:"SCIENCE", weight:1.0, cooldown:120.0,
  when:[AnomalyOf("alien_beacon")],
  choices:[
   (label:"Répondre au signal", result:"Le décodage prend des nuits ; l'équipage en sort troublé mais vous avez appris.", effects:[Research(120.0), Morale(-0.1)]),
   (label:"Brouiller la balise", result:"Le silence revient, et avec lui le calme.", effects:[Morale(0.03)]),
  ], window:15.0,
  text:"La balise inconnue de {place} change de rythme : elle semble avoir remarqué le vaisseau."),
 (id:"pillards_de_l_epave", name:"Pillards sur l'épave", tag:"CRIME", weight:0.8, cooldown:60.0,
  when:[AnomalyOf("derelict_ship"), Wanted],
  effects:[Cargo("spare_parts", 300.0), Rel(Contact, 0.03)],
  text:"Des pillards vous laissent démonter une épave dérivante : vous n'avez pas de loi à craindre ici."),
 (id:"collectionneur_d_artefacts", name:"Un collectionneur discret", tag:"SCIENCE", weight:1.0, cooldown:60.0,
  when:[AnomalyOf("artifact_field"), Contracts(1)],
  effects:[Contract("artifacts", 60.0, 3.0)],
  text:"Un collectionneur apprend que vous fréquentez un champ d'artefacts et vous propose un contrat à prix d'or."),
 (id:"helium_de_la_nebuleuse", name:"Le gaz de la nébuleuse", tag:"BOURSE", weight:1.0, cooldown:60.0,
  when:[AnomalyOf("nebula"), WorldEvent("penurie_helium")],
  effects:[Contract("helium3", 100.0, 2.5)],
  text:"La pénurie d'hélium fait regarder la nébuleuse de {place} d'un autre oeil : on vous commande du gaz."),
 (id:"glace_de_comete", name:"Prospecteurs sur la comète", tag:"BOURSE", weight:1.0, cooldown:50.0,
  when:[AnomalyOf("comet"), WorldEvent("famine")],
  effects:[Shock("water", 0.8, 20.0), Shock("water_ice", 0.8, 20.0)],
  text:"Des prospecteurs détournent une comète vers {place} : l'eau, au moins, ne manquera pas pendant la famine."),
 (id:"tempete_sur_la_colonie", name:"Tempête solaire sur les colonies", tag:"COLONIES", weight:1.0, cooldown:50.0,
  when:[WorldEvent("tempete_solaire"), ColonyNear(30.0)],
  effects:[ColonyHappiness(-0.08), Shock("batteries", 1.3, 15.0)],
  text:"Une tempête solaire griille les réseaux de vos colons : l'inquiétude monte et les batteries se vendent bien."),
 (id:"colonie_au_bord_de_la_revolte", name:"La colonie gronde", tag:"COLONIES", weight:1.2, cooldown:40.0,
  when:[ColonyUnrest(0.5)],
  choices:[
   (label:"Envoyer des vivres", result:"Les distributions calment la rue.", effects:[Cargo("food", -200.0), ColonyHappiness(0.15)]),
   (label:"Laisser faire", result:"L'émeute éclate ; {here} vous en tient responsable.", effects:[ColonyHappiness(-0.1), Rel(Here, -0.03)]),
  ], window:10.0,
  text:"La colère monte dans vos colonies de la région : le ravitaillement se fait attendre."),
 (id:"dividendes_de_la_colonie", name:"Une colonie qui rapporte", tag:"COLONIES", weight:0.8, cooldown:60.0,
  when:[ColonyNear(30.0), Rel(Here, Gt, 0.3)],
  effects:[Credits(1200.0)],
  text:"Les bonnes relations avec {here} font prospérer vos colonies : une prime de commerce vous revient."),
 (id:"deserteurs_en_guerre", name:"Déserteurs", tag:"GUERRE", weight:1.0, cooldown:50.0,
  when:[AtWar, Docked, Crew(2)],
  choices:[
   (label:"Les engager", result:"Les déserteurs apportent leur butin et leurs récits ; {here} ne l'oubliera pas.", effects:[Cargo("weapon_parts", 150.0), Morale(0.04), Rel(Here, -0.08)]),
   (label:"Les livrer", result:"{here} paie la prime et vous remercie.", effects:[Credits(500.0), Rel(Here, 0.1)]),
  ], window:8.0,
  text:"Des soldats déserteurs de la guerre voisine rôdent près des quais de {place}."),
 (id:"blocus_et_pirates", name:"Blocus", tag:"GUERRE", weight:1.0, cooldown:50.0,
  when:[AtWar, WorldEvent("piraterie")],
  effects:[Shock("fuel", 1.4, 20.0), Contract("fuel", 800.0, 2.0)],
  text:"Pirates et marines se disputent les routes : le carburant manque et la station de {place} offre un contrat pour en acheminer."),
 (id:"refugie_politique", name:"Un réfugié politique", tag:"POLITIQUE", weight:1.0, cooldown:60.0,
  when:[Unrest(0.3), Docked],
  choices:[
   (label:"L'héberger", result:"Le réfugié paie bien ; {here} gronde, {rival} sourit.", effects:[Rel(Here, -0.08), Credits(1500.0), Rel(Rival, 0.06)]),
   (label:"Le dénoncer", result:"{here} reçoit la nouvelle avec gratitude.", effects:[Rel(Here, 0.08), Credits(300.0)]),
  ], window:8.0,
  text:"Après le coup d'État à {place}, un notable frappe à votre sas et demande l'asile."),
 (id:"tuyau_boursier", name:"Un tuyau sur l'incident", tag:"ENTREPRISES", weight:1.0, cooldown:60.0,
  when:[Incident, Shares],
  choices:[
   (label:"En profiter", result:"Vous arbitrez à temps ; certains y verront un délit d'initié.", effects:[Credits(1500.0), Rel(Here, -0.06)]),
   (label:"Signaler la fuite", result:"Les autorités de {here} saluent votre probité.", effects:[Rel(Here, 0.05)]),
  ], window:6.0,
  text:"Un incident chez une entreprise de {place} fuit avant l'annonce officielle : vous détenez des actions."),
 (id:"incident_et_combustible", name:"Les raffineries s'arrêtent", tag:"ENTREPRISES", weight:1.0, cooldown:50.0,
  when:[Incident, CartelHere("ordre_helios")],
  effects:[Shock("fuel", 1.3, 15.0)],
  text:"Un incident bloque une raffinerie sous contrôle de l'Ordre d'Hélios : le carburant renchérit près de {place}."),
 (id:"huissiers", name:"Les huissiers de la banque", tag:"ENTREPRISES", weight:1.0, cooldown:30.0,
  when:[InDebt, Credits(Lt, 500.0)],
  effects:[Rel(Here, -0.05), Morale(-0.05)],
  text:"Vos dettes sont connues à {place} : les huissiers de la banque harcèlent l'équipage."),
 (id:"krach_et_clients", name:"Les clients renégocient", tag:"BOURSE", weight:1.0, cooldown:50.0,
  when:[WorldEvent("krach"), Contracts(1)],
  effects:[Credits(-800.0), Rel(Here, -0.02)],
  text:"Le krach pousse vos clients à renégocier tous vos contrats en cours : vous y laissez des plumes."),
 (id:"ruee_vers_les_outils", name:"Ruée sur les outils", tag:"BOURSE", weight:1.0, cooldown:50.0,
  when:[WorldEvent("ruee"), Territory("ceintures")],
  effects:[Contract("tools", 400.0, 2.0)],
  text:"Les mineurs des Ceintures se ruent sur l'or et manquent d'outils : un contrat vous est proposé."),
 (id:"cadeau_des_natifs", name:"Le présent des natifs", tag:"SCIENCE", weight:1.0, cooldown:80.0,
  when:[Civ, Rel(Civ, Gt, 0.5)],
  effects:[Cargo("artifacts", 6.0), Research(40.0), Rel(Civ, 0.05)],
  text:"Les natifs de {place} vous offrent des objets de leurs ancêtres en signe de confiance."),
 (id:"requete_des_natifs", name:"Une requête des natifs", tag:"SCIENCE", weight:1.0, cooldown:60.0,
  when:[Civ, Rel(Civ, Gt, 0.1)],
  choices:[
   (label:"Livrer des médicaments", result:"Les natifs ne l'oublieront pas.", effects:[Cargo("medicine", -150.0), Rel(Civ, 0.2), Rel(Here, 0.02)]),
   (label:"Refuser", result:"Les natifs détournent la tête.", effects:[Rel(Civ, -0.08)]),
  ], window:12.0,
  text:"Les natifs de {place} demandent des médicaments contre un mal qui frappe leurs enfants."),
 (id:"brouillage_des_natifs", name:"Des communications brouillées", tag:"SCIENCE", weight:1.0, cooldown:50.0,
  when:[Civ, Rel(Civ, Lt, -0.4)],
  effects:[Rel(Civ, -0.05), Morale(-0.05)],
  text:"Les natifs de {place} brouillent vos communications : ils n'ont pas oublié vos actes."),
 (id:"fete_et_luxe", name:"Commande de fête", tag:"BOURSE", weight:1.0, cooldown:40.0,
  when:[WorldEvent("fete"), Docked],
  effects:[Contract("luxury_goods", 300.0, 1.8)],
  text:"Les fêtes de {place} épuisent les réserves de luxe : la station passe commande."),
 (id:"convoi_a_escorter", name:"Convoi à escorter", tag:"GUERRE", weight:1.0, cooldown:50.0,
  when:[WorldEvent("piraterie"), Docked, Rel(Here, Gt, 0.2)],
  choices:[
   (label:"Escorter le convoi", result:"Le convoi passe ; {here} vous paie et vous cite en exemple.", effects:[Credits(1200.0), Rel(Here, 0.07), Morale(-0.03)]),
   (label:"Refuser", result:"Le convoi part sans vous.", effects:[]),
  ], window:6.0,
  text:"Face à la piraterie, {here} cherche un escorteur pour un convoi au départ de {place}."),
 (id:"equipage_a_bout", name:"L'équipage est à bout", tag:"POLITIQUE", weight:1.5, cooldown:30.0,
  when:[Morale(Lt, 0.3), Crew(3)],
  choices:[
   (label:"Offrir une permission", result:"Quelques jours à quai ramènent le sourire.", effects:[Credits(-800.0), Morale(0.25)]),
   (label:"Serrer la vis", result:"Le travail continue, la rancoeur aussi.", effects:[Morale(-0.08)]),
  ], window:6.0,
  text:"Le moral est au plus bas : on murmure dans les coursives de la mutinerie."),
 (id:"foire_aux_betes", name:"Concours agricole", tag:"COLONIES", weight:1.0, cooldown:80.0,
  when:[Herd, Territory("verdant")],
  effects:[Credits(900.0), Rel(Here, 0.03)],
  text:"Les Verdants ouvrent leur concours agricole : vos bêtes y raflent un prix."),
 (id:"don_scientifique", name:"Une bourse de recherche", tag:"SCIENCE", weight:1.0, cooldown:80.0,
  when:[WorldEvent("percee"), Rel(Faction("mars"), Gt, 0.2)],
  effects:[Research(100.0), Rel(Faction("mars"), 0.02)],
  text:"La percée scientifique du moment pousse la République de Mars à partager ses travaux avec ses amis, dont vous."),
 (id:"mines_en_greve_solidaire", name:"Grève de solidarité", tag:"ENTREPRISES", weight:0.9, cooldown:60.0,
  when:[WorldEvent("greve"), Rel(Faction("ceintures"), Gt, 0.3)],
  effects:[Rel(Faction("ceintures"), 0.05), Shock("cat:metal", 1.2, 15.0)],
  text:"Les mineurs de l'Union des Ceintures saluent votre soutien : la grève se prolonge et le métal reste cher."),
 (id:"caveau_cryo", name:"Un caveau cryo", tag:"SCIENCE", weight:0.5, cooldown:240.0,
  when:[InFlight, Anomaly],
  choices:[
   (label:"Reveiller les dormeurs", result:"Six personnes sortent du froid et parlent une langue d'avant : elles montent a bord avec leurs savoirs, et quelques dilemmes. Vous pouvez les rendormir dans vos caissons (K).", effects:[Cargo("colonists", 480.0), Research(40.0), Morale(0.05)]),
   (label:"Piller les caissons", result:"Les caissons vides sonnent creux, les pieces et les cryoprotecteurs se revendent bien ; l'equipage evite de regarder les occupants.", effects:[Cargo("spare_parts", 120.0), Cargo("cryoprotectant", 40.0), Credits(8000.0), Morale(-0.12)]),
   (label:"Les laisser dormir", result:"Vous notez la position du caveau : d'autres sauront peut-etre quoi en faire.", effects:[Research(10.0)]),
  ], window:20.0,
  text:"Dans une epave pres de {place}, un caveau gele tient encore : six dormeurs d'un age ancien, dans des caissons dont le courant tient par miracle. Sur la plaque, une langue que personne ne lit."),
]
