 patterns: [
  (kind:"star", voice:"stellar", forms:[("{root}",12),("{gr} {root}",2),("{root} {l}{n}",1),("{root}-{n}",1)]),
  (kind:"planet_dead", voice:"stellar", forms:[("{host} {idx}",8),("{host} {idx_l}",5),("{cat} {idx_l}",2),("{host}-{n}",1)]),
  (kind:"planet_living", voice:"stellar", forms:[("{root}",6),("{w:living_noun}",3),("{w:living_noun} de {root}",3),("{root}-{w:living_noun}",1),("{host} {idx}",1)]),
  (kind:"planet_giant", voice:"stellar", forms:[("{host} {idx}",6),("{w:titan}",4),("{root} {w:giant_epithet}",2),("{w:titan} {idx}",1)]),
  (kind:"moon_dead", voice:"stellar", forms:[("{host}-{idx_l}",8),("{host} {idx}",1),("{cat}",1)]),
  (kind:"moon_named", voice:"stellar", forms:[("{w:moon_myth}",6),("{root}",3),("{w:moon_myth} {idx}",1)]),
  (kind:"station", voice:"stellar", forms:[("Station {host}",6),("{w:station_noun} {root}",3),("{w:station_noun} de {host}",2),("{host} {w:station_suffix}",1),("Station {surname}",2),("{w:station_noun} {gr}",1)]),
  (kind:"anomaly", voice:"deep", forms:[("{label} {host}-{n}",5),("{label} de {root}",3),("{label} {gr}-{n}",2),("{w:anom_noun} de {root}",2)]),
  (kind:"nebula", voice:"deep", forms:[("Nébuleuse {root}",4),("Nébuleuse du {w:neb_noun}",3),("Nébuleuse {w:neb_adj} de {root}",2),("{w:neb_noun} de {root}",2),("Nébuleuse {cat}",1)]),
  (kind:"constellation", voice:"deep", forms:[("Constellation {root}",4),("Constellation du {w:neb_noun}",3),("{w:neb_noun} de {root}",2)]),
  (kind:"cluster", voice:"deep", forms:[("Amas {root}",4),("Amas du {w:neb_noun}",2),("Amas {gr} {root}",2),("Amas {cat}",2),("Essaim {root}",1)]),
  (kind:"sector", voice:"stellar", forms:[("Secteur {root}",5),("{w:sector_noun} de {root}",4),("Secteur {gr}-{n}",1)]),
  (kind:"galaxy", voice:"deep", forms:[("Galaxie {root}",3),("NGC {n4}",3),("UGC {n4}",2),("Galaxie du {w:neb_noun}",1),("{root} {rom}",1),("Galaxie {cat}",1)]),
  (kind:"city", voice:"stellar", forms:[("{root}",6),("{root}{w:place_suffix}",3),("{w:place_prefix} {root}",3),("{w:city_noun} {root}",2),("{root}{w:city_suffix}",1),("{w:city_noun} {surname}",1)]),
  (kind:"colony", voice:"stellar", forms:[("{root}",5),("Nouvelle {root}",2),("{w:city_noun} {root}",3),("{w:living_noun} de {root}",1),("{surname}-{root}",1)]),
  (kind:"river", voice:"stellar", forms:[("{w:river_noun} {root}",6),("{w:river_noun} {surname}",1),("{w:river_noun} {w:neb_adj}",1)]),
  (kind:"mountain", voice:"stellar", forms:[("{w:mountain_noun} {root}",6),("{w:mountain_noun} {surname}",1),("{w:mountain_noun} {w:adj_m}",1)]),
  (kind:"water", voice:"stellar", forms:[("{w:water_noun} {root}",6),("{w:water_noun} {w:neb_adj}",1),("{w:water_noun} {surname}",1)]),
  (kind:"region", voice:"stellar", forms:[("{w:region_noun} {root}",5),("{w:region_noun} de {root}",3),("{w:region_noun} {surname}",1)]),
  (kind:"company", voice:"stellar", forms:[("{surname} {w:corp_sector} {w:legal}",4),("{w:corp_sector} {root} {w:legal}",3),("{w:corp_prefix} {root}",3),("{surname} et {surname}",2),("{root} {w:corp_sector}",2),("{w:corp_prefix} {w:corp_sector} de {root}",2)]),
  (kind:"ai", voice:"stellar", forms:[("{w:ai_name}",1)]),
  (kind:"ship_civil_m", voice:"stellar", forms:[("Le {w:ship_noun_m}",5),("Le {w:ship_noun_m} {w:ship_adj_m}",3),("{root}",2),("{given} {surname}",1)]),
  (kind:"ship_civil_f", voice:"stellar", forms:[("La {w:ship_noun_f}",5),("La {w:ship_noun_f} {w:ship_adj_f}",3),("{root}",2),("{given} {surname}",1)]),
  (kind:"ship_pirate_m", voice:"stellar", forms:[("Le {w:pirate_noun_m} {w:pirate_adj_m}",6),("Le {w:pirate_noun_m} de {root}",2),("{w:pirate_noun_m} {root}",1)]),
  (kind:"ship_pirate_f", voice:"stellar", forms:[("La {w:pirate_noun_f} {w:pirate_adj_f}",6),("La {w:pirate_noun_f} de {root}",2),("{w:pirate_noun_f} {root}",1)]),
  (kind:"cartel", voice:"stellar", forms:[("{w:cartel_noun} de {w:cartel_of}",4),("{w:cartel_noun} {w:cartel_adj}",3),("{w:cartel_noun} {root}",2),("Les Frères {surname}",1)]),
  (kind:"religion", voice:"stellar", forms:[("{w:rel_noun2} de {w:rel_noun}",4),("Les {w:rel_plural} de {root}",3),("{w:rel_noun2} des {w:rel_plural}",3),("Voie {w:rel_adj} de {root}",1)]),
  (kind:"faction", voice:"stellar", forms:[("{w:fac_noun} {w:fac_adj}",4),("{w:fac_noun} de {root}",4)]),
