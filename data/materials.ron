  ground_of:[("desert",4.0), ("plaine_brulante",1.0), ("savane",1.0)],
  text:"Sable cimenté, sculpté par le vent."),
 (id:"basalte", yields:[("iron",4.0,0.8), ("titanium",1.0,0.3), ("magnesium",1.0,0.3), ("rare_earths",0.2,0.1)], under:"basalte_fracture", name:"Basalte", kind:"wall", glyphs:"#&", color:0x00484850, pattern:"bruit", hardness:0.8,
