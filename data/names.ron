   end:["n","s","x","th","ra","ia","on","is","a","um","or","eth","ar","us","ix","en","os","ae","ion","ara","eus","ore","ula","yn","el","ard"],
   mid_chance:0.55),
  (id:"deep",
   start:["Ny","Zeph","Ur","Oma","Xan","Vho","Kra","Iss","Oul","Thra","Gha","Ymi","Aez","Nul","Quo","Zhe","Omn","Eld","Pyr","Hyp"],
   mid:["thar","lum","gor","vyn","zaa","mor","qui","dal","nex","ish"],
   end:["ion","ae","ua","ys","ath","om","eir","oth","un","ia","ax","or"],
   mid_chance:0.5),
 ],
