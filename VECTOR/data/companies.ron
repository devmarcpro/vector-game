// Companies listed on the exchange (E6, "les entreprises"). goods: (resource id, weight): the
// share price follows the world prices of what the company makes and sells, around `base`
// credits; yield: yearly dividend as a share of the price; vol: how jumpy it is on its own.
// The hq is a faction; its mores colour the company (see the codex).
[
 (id:"helios_forge", name:"Hélios Forges", hq:"helios", base:120.0, yield_year:0.05, vol:0.10,
  goods:[("steel",0.5),("iron",0.3),("machinery",0.2)],
  text:"Aciéries orbitales du consortium Hélios : tout le monde en achète, personne ne les aime."),
 (id:"ligue_comptoirs", name:"Comptoirs de la Ligue", hq:"ligue", base:80.0, yield_year:0.04, vol:0.07,
  goods:[("consumer_goods",0.4),("luxury_goods",0.3),("food",0.3)],
  text:"Chaîne de comptoirs marchands : vit de la consommation de la Ligue jovienne."),
 (id:"mars_biotech", name:"Biotech Martienne", hq:"mars", base:150.0, yield_year:0.02, vol:0.18,
  goods:[("medicine",0.5),("organics",0.2),("fertilizer",0.3)],
  text:"Laboratoires de Mars : médicaments, greffons et brevets ; très sensible aux scandales."),
 (id:"ceintures_minerais", name:"Minerais des Ceintures", hq:"ceintures", base:60.0, yield_year:0.06, vol:0.12,
  goods:[("nickel",0.3),("iron",0.3),("platinum",0.2),("rare_earths",0.2)],
  text:"Coopérative de mineurs libertaires : vend au plus offrant."),
 (id:"hegemonie_armes", name:"Arsenaux de l'Hégémonie", hq:"hegemonie", base:200.0, yield_year:0.045, vol:0.14,
  goods:[("ammo_slugs",0.4),("weapon_parts",0.4),("uranium",0.2)],
  text:"Fabricant d'armes d'État : monte avec les tensions, tombe avec la paix."),
 (id:"concorde_energie", name:"Énergies de la Concorde", hq:"concorde", base:95.0, yield_year:0.055, vol:0.08,
  goods:[("fuel_rods",0.4),("batteries",0.3),("solar_cells",0.3)],
  text:"Fusion, batteries et panneaux : le grand fournisseur d'énergie des mondes ouverts."),
 (id:"errants_transport", name:"Transports Errants", hq:"errants", base:45.0, yield_year:0.07, vol:0.16,
  goods:[("hydrogen",0.4),("water",0.3),("food",0.3)],
  text:"Convois de clans nomades : bon marché, risqué, toujours en route."),
 (id:"verdant_semences", name:"Semences du Verdant", hq:"verdant", base:70.0, yield_year:0.03, vol:0.09,
  goods:[("food",0.4),("fertilizer",0.4),("medicine",0.2)],
  text:"Agronomes verdants : récoltes, engrais et plantes médicinales."),
]
