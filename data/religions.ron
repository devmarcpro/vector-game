// Beliefs of the colonies (E6). A colony takes the belief whose range of the "foi" axis contains
// the faith of its people (see the culture of the colony), drawn among the candidates by the hash
// of its founding. morale: added to the target of its happiness; research: extra share of the
// research it produces; text: what people there believe.
[
 (id:"raison", name:"Raison civique", foi_min:-1.0, foi_max:-0.3, morale:0.01, research:0.15,
  text:"Pas de dieux, mais des lois, des écoles et le goût de comprendre."),
 (id:"cercle", name:"Cercle des étoiles", foi_min:-0.5, foi_max:0.4, morale:0.03, research:0.05,
  text:"Une foi souple : chaque naissance est une étoile qui s'allume."),
 (id:"veilleurs", name:"Veilleurs du sol", foi_min:0.0, foi_max:1.0, morale:0.04, research:0.0,
  text:"On ne quitte pas la terre qui nourrit ; les ancêtres veillent sous les champs."),
 (id:"voie_du_feu", name:"Voie du feu", foi_min:0.3, foi_max:1.0, morale:0.06, research:-0.05,
  text:"Le feu purifie et unit ; les fêtes sont longues et les doutes brûlés."),
 (id:"culte_machine", name:"Église de la Machine", foi_min:-0.6, foi_max:0.6, morale:0.02, research:0.12,
  text:"L'ordre est dans les engrenages : entretenir un réacteur est une prière."),
]
