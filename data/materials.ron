// Materials of the ground and of the walls (see rogue.rs, rogue_view.rs, fpv_view.rs). A cell of any
// place is made of one: its colour and the character that stands for it come from here, in the map
// as in the first-person view. kind: floor, wall or liquid. glyphs: the characters that vary from
// cell to cell. pattern (first person): pierre (courses of blocks), panneau (plates), bruit (rough
// rock), lisse. hardness: 0..1. ground_of: (biome, weight) where it makes up the ground of a
// landing (every land biome needs at least one floor and one wall).
// What the matter does and gives: yields: (resource, kg, rarity 0..1) what digging the cell gives,
// scaled by the world's physics; under: the floor material laid bare once dug (a wall with no
// `under` cannot be dug; a floor with none is bedrock); harm: health lost per turn standing on it
// (a liquid burns whoever stands next to it, at a third); slick: chance to slide one more cell;
// fertility: 0..1, how well plants take root there; cost: (resource, kg) of the pack it takes to
// build one cell of it (a material with a cost can be built by the squad).
[
 // ---- ground of the worlds ------------------------------------------------------------------
 (id:"regolithe", yields:[("regolith",6.0,0.9), ("iron",0.8,0.3)], under:"roche_nue", fertility:0.05, name:"Régolithe", kind:"floor", glyphs:".,'`", color:0x008A8478, pattern:"bruit", hardness:0.2,
  ground_of:[("plaine_rocheuse",3.0), ("massif",1.0), ("desert",0.5), ("montagne",0.5)],
  text:"Poussière de roche brisée par les impacts et le gel."),
 (id:"sable", yields:[("silica",5.0,0.9)], under:"roche_nue", fertility:0.05, name:"Sable", kind:"floor", glyphs:".:'", color:0x00D8B868, pattern:"bruit", hardness:0.05, slow:1.3,
  ground_of:[("desert",4.0), ("plaine_brulante",1.0), ("savane",0.5)],
  text:"Quartz usé par le vent."),
 (id:"sable_rouge", yields:[("iron",3.0,0.6), ("silica",3.0,0.7)], under:"roche_nue", fertility:0.05, name:"Sable rouge", kind:"floor", glyphs:".:'", color:0x00B86038, pattern:"bruit", hardness:0.05, slow:1.3,
  ground_of:[("plaine_brulante",3.0), ("desert",1.0)],
  text:"Sable chargé d'oxydes de fer."),
 (id:"cendre", yields:[("sulfur",1.5,0.5), ("silica",2.0,0.6)], under:"roche_nue", fertility:0.15, name:"Cendre volcanique", kind:"floor", glyphs:",.`", color:0x00585860, pattern:"bruit", hardness:0.1, slow:1.15,
  ground_of:[("coulee_de_lave",3.0), ("plaine_brulante",1.0)],
  text:"Grisaille légère retombée des éruptions."),
 (id:"soufre", name:"Croûte de soufre", kind:"floor", glyphs:".:*", color:0x00D8D030, pattern:"bruit", hardness:0.3,
  yields:[("sulfur",4.0,0.9)], under:"roche_nue", harm:0.004,
  ground_of:[("coulee_de_lave",0.8), ("plaine_brulante",0.3)],
  text:"Dépôt jaune des fumerolles ; les vapeurs piquent les poumons."),
 (id:"basalte_fracture", yields:[("iron",3.0,0.7), ("magnesium",1.0,0.4)], under:"roche_nue", name:"Basalte fracturé", kind:"floor", glyphs:".:;", color:0x00383840, pattern:"bruit", hardness:0.7,
  ground_of:[("coulee_de_lave",3.0)],
  text:"Lave refroidie et craquelée."),
 (id:"neige", yields:[("water_ice",4.0,0.95)], under:"sol_gele", name:"Neige", kind:"floor", glyphs:".*'", color:0x00E8F0FF, pattern:"lisse", hardness:0.05, slow:1.5,
  ground_of:[("calotte",5.0), ("toundra",1.0), ("montagne",1.0), ("taiga",0.5)],
  text:"Cristaux d'eau tassés par le froid."),
 (id:"glace", yields:[("water_ice",8.0,0.95)], under:"sol_gele", slick:0.6, name:"Glace", kind:"floor", glyphs:".-", color:0x00A8D8F0, pattern:"lisse", hardness:0.4, slow:0.8,
  ground_of:[("calotte",2.0), ("toundra",0.5)],
  text:"Glace vive, glissante et claire."),
 (id:"sol_gele", yields:[("water_ice",2.0,0.5), ("regolith",2.0,0.6)], under:"roche_nue", fertility:0.3, name:"Sol gelé", kind:"floor", glyphs:",.:", color:0x007A8A78, pattern:"bruit", hardness:0.5,
  ground_of:[("toundra",4.0), ("taiga",1.0), ("montagne",1.0)],
  text:"Terre durcie par le pergélisol, lichens clairsemés."),
 (id:"mousse", yields:[("organics",1.0,0.8)], under:"humus", fertility:0.8, name:"Mousse", kind:"floor", glyphs:"\"',.", color:0x005E8A5A, pattern:"bruit", hardness:0.02, slow:1.1,
  ground_of:[("toundra",1.5), ("taiga",1.5), ("marais",1.0), ("foret_temperee",0.5)],
  text:"Tapis vivant qui retient l'eau."),
 (id:"humus", yields:[("organics",2.0,0.9), ("phosphorus",0.3,0.3)], under:"roche_nue", fertility:1.0, name:"Humus", kind:"floor", glyphs:",.;", color:0x006A5038, pattern:"bruit", hardness:0.05, slow:1.1,
  ground_of:[("foret_temperee",3.0), ("taiga",2.0), ("jungle",3.0), ("prairie",1.0), ("marais",1.0)],
  text:"Terre noire des sous-bois, riche en débris."),
 (id:"herbe", yields:[("organics",1.2,0.9)], under:"humus", fertility:1.0, name:"Herbe", kind:"floor", glyphs:"\",'", color:0x0058A850, pattern:"bruit", hardness:0.02,
  ground_of:[("prairie",4.0), ("foret_temperee",2.0), ("steppe",1.0), ("savane",1.0)],
  text:"Herbes vertes et courtes."),
 (id:"herbe_seche", yields:[("organics",0.8,0.8)], under:"humus", fertility:0.5, name:"Herbe sèche", kind:"floor", glyphs:"\",'.;", color:0x00C0B060, pattern:"bruit", hardness:0.02,
  ground_of:[("steppe",4.0), ("savane",4.0), ("prairie",0.5)],
  text:"Paille dorée des saisons sèches."),
 (id:"boue", yields:[("water",2.0,0.7), ("silica",1.0,0.5)], under:"roche_nue", fertility:0.6, name:"Boue", kind:"floor", glyphs:"~,.;", color:0x006A5A40, pattern:"bruit", hardness:0.0, slow:2.0,
  ground_of:[("marais",4.0), ("jungle",1.0)],
  text:"Limon gorgé d'eau, on s'y enfonce."),
 (id:"gravier", yields:[("silica",3.0,0.8), ("iron",1.0,0.4)], under:"roche_nue", fertility:0.1, name:"Gravier", kind:"floor", glyphs:":.,;", color:0x00908880, pattern:"bruit", hardness:0.3, slow:1.1,
  ground_of:[("massif",3.0), ("montagne",3.0), ("plaine_rocheuse",2.0), ("steppe",0.3)],
  text:"Éclats de roche roulés par l'eau et le gel."),
 (id:"croute_de_sel", yields:[("magnesium",1.0,0.4), ("lithium",0.3,0.15)], under:"roche_nue", name:"Croûte de sel", kind:"floor", glyphs:".:", color:0x00E0DCD0, pattern:"lisse", hardness:0.3,
  ground_of:[("desert",0.8), ("plaine_brulante",0.3)],
  text:"Ce qu'a laissé une mer disparue."),
 // ---- rocks and trees that stand in the way ---------------------------------------------------
 (id:"roche", yields:[("silica",4.0,0.9), ("iron",3.0,0.7), ("aluminium",1.0,0.35), ("copper",0.6,0.2), ("gold",0.05,0.04)], under:"roche_nue", name:"Roche silicatée", kind:"wall", glyphs:"#%", color:0x00908880, pattern:"bruit", hardness:0.7,
