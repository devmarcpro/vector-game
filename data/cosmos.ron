// Astronomy: the stage of a star, the objects of a system and of the space between the stars (see
// crates/world/src/stellar.rs and cosmos.rs, which own the numbers: the codex reads them from
// there). group: etoile, systeme, milieu, galaxie, asteroide. link: the asteroid class whose
// composition (asteroids.ron) the entry shows, or "".
[
 // ---- life of the stars ----------------------------------------------------------------------
 (id:"main_sequence", name:"Séquence principale", group:"etoile", link:"",
  text:"La vie adulte d'une étoile : elle fond de l'hydrogène en hélium au cœur. Plus elle est massive, plus elle brille et moins elle dure : un millier de milliards d'années pour une naine rouge, dix milliards pour le Soleil, quelques millions pour une étoile O."),
 (id:"red_giant", name:"Géante rouge", group:"etoile", link:"",
  text:"Le cœur d'hydrogène épuisé, l'étoile gonfle et rougit. Elle pulse (type Mira) et avale ou grille ses mondes intérieurs, mais ses planètes lointaines dégèlent."),
 (id:"red_supergiant", name:"Supergéante rouge", group:"etoile", link:"",
  text:"Le stade des étoiles massives avant la supernova : des centaines de rayons solaires, une luminosité de dizaines de milliers de soleils, une pulsation lente."),
 (id:"white_dwarf", name:"Naine blanche", group:"etoile", link:"",
  text:"Le cœur nu d'une étoile moyenne, gros comme la Terre, qui ne fait plus que refroidir. Ses planètes survivantes sont serrées contre elle."),
 (id:"neutron_star", name:"Étoile à neutrons", group:"etoile", link:"",
  text:"Le cœur effondré d'une supernova : 1,2 à 2,2 masses solaires dans une boule de douze kilomètres. Elle ne garde presque aucun monde."),
 (id:"black_hole", name:"Trou noir stellaire", group:"etoile", link:"",
  text:"Un horizon de trois kilomètres par masse solaire, aucune lumière propre. Il n'a pas de planètes ; s'il se nourrit d'un disque il rayonne en X, et sa gravité fait lentille."),
 (id:"rogue_planet", name:"Planète errante", group:"etoile", link:"",
  text:"Un monde de masse planétaire expulsé de son système, sans soleil : froid, sombre, suivi de quelques lunes glacées."),
 (id:"pulsar", name:"Pulsar", group:"etoile", link:"",
  text:"Une étoile à neutrons qui tourne de quelques millisecondes à quelques secondes et balaie l'espace de ses faisceaux : une dose de rayonnement qui décroît comme le carré de la distance."),
 (id:"magnetar", name:"Magnétar", group:"etoile", link:"",
  text:"Un pulsar au champ magnétique mille fois plus fort : sa dose est vingt fois plus élevée et il lance de violents sursauts."),
 (id:"variable_star", name:"Étoile variable", group:"etoile", link:"",
  text:"Les géantes pulsent : leur lumière varie périodiquement (type Mira pour une géante rouge, type Céphéide pour une supergéante). Les panneaux solaires du vaisseau suivent la courbe de lumière."),
 (id:"binary_star", name:"Étoile double", group:"systeme", link:"",
  text:"Un système à deux ou trois soleils. Le compagnon est assez loin (au moins huit fois la dernière planète) pour que les orbites restent stables, et sa lumière s'ajoute à celle de l'étoile principale."),
 (id:"gravitational_lens", name:"Lentille gravitationnelle", group:"systeme", link:"",
  text:"La gravité d'un trou noir courbe la lumière : à sa distance focale, vos capteurs voient plus loin."),
 (id:"comet_tail", name:"Comète", group:"systeme", link:"",
  text:"Une orbite très excentrique : la comète plonge près de l'étoile, la glace bout et le vent stellaire souffle la queue à l'opposé du soleil. Elle est longue au périhélie, nulle loin du soleil, et son plasma abîme l'électronique."),
 (id:"ring", name:"Anneau", group:"systeme", link:"",
  text:"Les débris d'une lune glacée déchirée par les marées : un anneau ne peut exister qu'à l'intérieur de la limite de Roche de la planète. Ses blocs sont de vrais astéroïdes, riches en glace, que l'on peut miner."),
 (id:"trojans", name:"Troyens", group:"systeme", link:"",
  text:"Deux essaims de roches sombres, soixante degrés devant et derrière une géante gazeuse sur sa propre orbite : les points de Lagrange L4 et L5 sont stables."),
 // ---- milieu interstellaire ------------------------------------------------------------------------
 (id:"emission_nebula", name:"Nébuleuse en émission", group:"milieu", link:"",
  text:"Du gaz ionisé par de jeunes étoiles chaudes, qui brille en rouge. Il brouille les capteurs et pique un peu."),
 (id:"reflection_nebula", name:"Nébuleuse par réflexion", group:"milieu", link:"",
  text:"De la poussière qui diffuse la lumière d'une étoile voisine : bleue, douce, belle, sans danger mais opaque aux scanners."),
 (id:"planetary_nebula", name:"Nébuleuse planétaire", group:"milieu", link:"",
  text:"La coquille de gaz expulsée par une étoile qui meurt, éclairée par la naine blanche qu'elle laisse. Rayonnement ultraviolet intense."),
 (id:"supernova_remnant", name:"Rémanent de supernova", group:"milieu", link:"",
  text:"Les débris d'une étoile qui a explosé, encore chauds : rayonnement dur, capteurs aveuglés, et un pulsar peut-être en son cœur. Un lieu d'étude de premier ordre."),
 (id:"open_cluster", name:"Amas ouvert", group:"milieu", link:"",
  text:"Quelques centaines de jeunes étoiles nées ensemble dans le disque de la galaxie, qui se dispersent lentement."),
 (id:"globular_cluster", name:"Amas globulaire", group:"milieu", link:"",
  text:"Un million de vieilles étoiles serrées en boule, dans le halo et le bulbe. Presque pas de poussière : les capteurs voient très bien."),
 (id:"star_forming_region", name:"Région de formation d'étoiles", group:"milieu", link:"",
  text:"Un nuage dense qui s'effondre en étoiles le long des bras spiraux : chaud, opaque, radiatif."),
 // ---- galaxy ---------------------------------------------------------------------------------------
 (id:"supermassive_black_hole", name:"Trou noir supermassif", group:"galaxie", link:"",
  text:"Au centre de la galaxie, 4,3 millions de masses solaires. Son disque et ses jets inondent le noyau de rayonnement, qui décroît comme le carré de la distance."),
 (id:"quasar", name:"Quasar", group:"galaxie", link:"",
  text:"Le noyau d'une galaxie lointaine dont le trou noir central dévore la matière : la lumière de milliers de galaxies dans un point, vue du fond du ciel."),
 (id:"gravitational_waves", name:"Ondes gravitationnelles", group:"galaxie", link:"",
  text:"La fusion de deux objets compacts ride l'espace lui-même. Vos gravimètres entendent les plus forts : plus la masse de chirp est grande et plus la source est proche, plus la déformation est forte, et plus l'étude rapporte."),
 // ---- asteroids ----------------------------------------------------------------------------------------
 (id:"asteroid_c", name:"Astéroïde de type C", group:"asteroide", link:"C",
  text:"Carbonés, sombres, les plus nombreux : de l'eau, du carbone et des composés organiques."),
 (id:"asteroid_s", name:"Astéroïde de type S", group:"asteroide", link:"S",
  text:"Siliceux : silicates de fer et de magnésium, la matière des mondes rocheux."),
 (id:"asteroid_m", name:"Astéroïde de type M", group:"asteroide", link:"M",
  text:"Métalliques : le cœur de fer et de nickel d'un corps différencié détruit, avec du platine."),
 (id:"asteroid_i", name:"Astéroïde de glace", group:"asteroide", link:"I",
  text:"Glace d'eau, de CO2 et d'ammoniac : le carburant et l'eau des vaisseaux."),
 (id:"asteroid_v", name:"Astéroïde de type V", group:"asteroide", link:"V",
  text:"Basaltiques : la croûte d'un corps différencié (la famille de Vesta) brisée par un impact, riche en silicates, en titane et en chrome."),
 (id:"asteroid_d", name:"Astéroïde de type D", group:"asteroide", link:"D",
  text:"Très sombres, primitifs, chargés d'organiques et de glaces : ils peuplent le système externe et les points de Lagrange des géantes (les Troyens)."),
]
