[
 (id:"electrolysis_water", name:"Électrolyse de l'eau", kind:"electrolyse", reactants:[("water",2)], products:[("hydrogen",2), ("oxygen",1)], t_act:300.0, p_min:1.0,
  text:"Le courant sépare l'eau : l'oxygène fait l'air du bord, l'hydrogène le carburant."),
