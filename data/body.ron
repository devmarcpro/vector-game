 (id:"torse", name:"Torse", hit:0.32, limb:false, organs:["coeur","poumons","foie","reins","estomac"], effects:[("health_base",-0.1)]),
 (id:"bras_g", name:"Bras gauche", hit:0.14, limb:true, organs:["muscles"], effects:[("work_speed",-0.12)]),
 (id:"bras_d", name:"Bras droit", hit:0.14, limb:true, organs:["muscles"], effects:[("work_speed",-0.12)]),
 (id:"jambe_g", name:"Jambe gauche", hit:0.15, limb:true, organs:["os"], effects:[("work_speed",-0.1),("stress_resist",-0.05)]),
 (id:"jambe_d", name:"Jambe droite", hit:0.15, limb:true, organs:["os"], effects:[("work_speed",-0.1),("stress_resist",-0.05)]),
