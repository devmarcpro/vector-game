  text:"Le charbon brûle : de la chaleur et du CO2."),
 (id:"sulfur_combustion", name:"Combustion du soufre", kind:"combustion", reactants:[("sulfur",1), ("oxygen",1)], products:[("sulfur_dioxide",1)], t_act:520.0, p_min:1.0,
  text:"Fait le gaz âcre des volcans."),
 (id:"magnesium_combustion", name:"Combustion du magnésium", kind:"combustion", reactants:[("magnesium",2), ("oxygen",1)], products:[("magnesia",2)], t_act:750.0, p_min:1.0,
  text:"Une flamme blanche qu'on n'éteint pas à l'eau."),
