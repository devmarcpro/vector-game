 (id:"bosquet", yields:[("organics",5.0,0.95), ("construction_materials",1.5,0.5)], under:"humus", name:"Bosquet dense", kind:"wall", glyphs:"&%", color:0x002E6A34, pattern:"bruit", hardness:0.3,
  ground_of:[("foret_temperee",3.0), ("jungle",3.0), ("taiga",2.0), ("marais",1.0)],
  text:"Troncs et broussailles trop serrés pour passer."),
