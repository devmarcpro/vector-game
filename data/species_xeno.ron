// Xenobiology (E2b): species of NON-carbon-water chemistries, appended to species.ron at load time.
// Same fields as species.ron. Which chemistry each belongs to is in data/xenobio.ron.
// They live in the biomes of hostile worlds (no air, scorched plains, lava, ice caps, boiling seas).
[
 (id:"lichen_de_silice", name:"Lichen de silice", trophic:"producer", habitat:["plaine_brulante", "coulee_de_lave"], diet:[], body:0.05, growth:0.04, yields:[("silica",0.02), ("organics",0.03)], domestic:false, danger:0.0, invasive:0.0, text:"Croûte siliceuse qui tire son énergie de l'oxydation du soufre."),
 (id:"cristal_vivant", name:"Cristal vivant", trophic:"producer", habitat:["coulee_de_lave"], diet:[], body:5.0, growth:0.02, yields:[("silicon",1.0)], domestic:false, danger:0.1, invasive:0.0, text:"Cristaux qui croissent et se divisent dans la roche fondue."),
 (id:"broyeur_de_basalte", name:"Broyeur de basalte", trophic:"herbivore", habitat:["plaine_brulante", "coulee_de_lave"], diet:["lichen_de_silice", "cristal_vivant"], body:40.0, growth:0.02, yields:[("silicon",2.0), ("organics",4.0)], domestic:false, danger:0.2, invasive:0.0, text:"Mâchoires de céramique, il broute les cristaux."),
 (id:"serpent_de_scorie", name:"Serpent de scorie", trophic:"carnivore", habitat:["plaine_brulante", "coulee_de_lave"], diet:["broyeur_de_basalte"], body:300.0, growth:0.008, yields:[("silicon",5.0), ("organics",20.0)], domestic:false, danger:0.9, invasive:0.0, text:"Corps de silicate souple, il chasse sur la roche rougeoyante."),
 (id:"frange_d_ammoniac", name:"Frange d'ammoniac", trophic:"producer", habitat:["calotte", "mer_gelee"], diet:[], body:0.01, growth:0.06, yields:[("ammonia",0.01), ("organics",0.01)], domestic:false, danger:0.0, invasive:0.0, text:"Filaments vivant dans un solvant d'ammoniac liquide, sous la glace."),
 (id:"glissant_cryogene", name:"Glissant cryogène", trophic:"herbivore", habitat:["calotte", "mer_gelee"], diet:["frange_d_ammoniac"], body:8.0, growth:0.03, yields:[("ammonia",3.0)], domestic:false, danger:0.0, invasive:0.0, text:"Il glisse sous la banquise en broutant les franges."),
 (id:"traqueur_des_glaces", name:"Traqueur des glaces", trophic:"carnivore", habitat:["calotte", "mer_gelee"], diet:["glissant_cryogene"], body:90.0, growth:0.01, yields:[("ammonia",15.0), ("organics",30.0)], domestic:false, danger:0.7, invasive:0.0, text:"Prédateur lent des mers d'ammoniac."),
 (id:"melanine_rayonnante", name:"Mélanine rayonnante", trophic:"producer", habitat:["plaine_rocheuse", "massif"], diet:[], body:0.02, growth:0.03, yields:[("organics",0.02)], domestic:false, danger:0.0, invasive:0.0, text:"Pigment noir qui convertit le rayonnement ionisant en énergie chimique."),
 (id:"brouteur_de_regolithe", name:"Brouteur de régolithe", trophic:"herbivore", habitat:["plaine_rocheuse", "massif"], diet:["melanine_rayonnante"], body:3.0, growth:0.02, yields:[("organics",1.5)], domestic:false, danger:0.0, invasive:0.0, text:"Il racle les croûtes de mélanine sur la roche sans air."),
 (id:"predateur_de_roche", name:"Prédateur de roche", trophic:"carnivore", habitat:["plaine_rocheuse", "massif"], diet:["brouteur_de_regolithe"], body:60.0, growth:0.008, yields:[("organics",20.0)], domestic:false, danger:0.6, invasive:0.0, text:"Blindé contre les radiations, il guette dans les cratères."),
 (id:"tapis_sulfureux", name:"Tapis sulfureux", trophic:"producer", habitat:["mer_bouillante"], diet:[], body:0.01, growth:0.2, yields:[("sulfur",0.02)], domestic:false, danger:0.0, invasive:0.0, text:"Colonies chimiosynthétiques des sources hydrothermales."),
 (id:"ver_de_fumeur", name:"Ver de fumeur", trophic:"herbivore", habitat:["mer_bouillante"], diet:["tapis_sulfureux"], body:2.0, growth:0.05, yields:[("sulfur",0.5), ("organics",1.0)], domestic:false, danger:0.0, invasive:0.0, text:"Vit contre les cheminées d'eau surchauffée."),
 (id:"crabe_thermal", name:"Crabe thermal", trophic:"carnivore", habitat:["mer_bouillante"], diet:["ver_de_fumeur"], body:25.0, growth:0.02, yields:[("food",8.0)], domestic:false, danger:0.3, invasive:0.0, text:"Carapace épaisse, il pille les colonies de vers."),
