// Sections of ship assembled on a grid of cells of 6 m (see crates/data/src/ship.rs).
// Axes: x runs to the nose, y to starboard, z up. ports: bits +x 1, -x 2, +y 4, -y 8, +z 16, -z 32.
// mass kg, volume/hab_m3 m3, hp structure, materials (resource, kg), labor person-days,
// support_kg: load of a landing leg at 1 g, rcs: thrust (N) of the attitude thrusters,
// room: what the part is on the plan of the inside (passerelle cabines soute ingenierie hangar coursive).
[
 (id:"core_cockpit", name:"Noyau d'IA et passerelle", kind:"cockpit", mass:1800.0, volume:120.0, hab_m3:40.0, hp:900.0, materials:[("electronics",120.0), ("circuits",60.0), ("hull_plates",400.0), ("steel",300.0)], labor:40.0, ports:63, slots:[(Core,2), (Internal,2)], berths:2, aero_area:20.0, rcs:8000.0, room:"passerelle", text:"Le cœur du vaisseau : le noyau où tourne l'IA du bord et la passerelle de ses opérateurs. Sans lui, pas de vaisseau."),
 (id:"core_command", name:"Noyau de commandement", kind:"cockpit", mass:3200.0, volume:180.0, hab_m3:70.0, hp:1600.0, materials:[("electronics",300.0), ("circuits",160.0), ("hull_plates",800.0), ("steel",500.0), ("robotics",40.0)], labor:90.0, ports:63, slots:[(Core,3), (Core,2), (Internal,3)], berths:4, aero_area:26.0, rcs:14000.0, room:"passerelle", text:"Un noyau blindé et redondant pour les grandes unités : état-major, salle des cartes, calcul massif."),
 (id:"hull_frame", name:"Tronçon de coque", kind:"hull", mass:1200.0, volume:140.0, hab_m3:60.0, hp:700.0, materials:[("steel",400.0), ("hull_plates",300.0), ("aluminium_alloy",100.0)], labor:20.0, ports:63, slots:[(Internal,3)], aero_area:25.0, room:"coursive", text:"Tronçon cylindrique standard : cadre, tôles de coque et coursive. La brique de base de tout vaisseau."),
 (id:"hull_nose", name:"Cône d'étrave", kind:"hull", mass:900.0, volume:70.0, hab_m3:20.0, hp:650.0, materials:[("steel",250.0), ("hull_plates",280.0), ("ceramics",60.0)], labor:16.0, ports:2, slots:[(External,2)], aero_area:14.0, room:"coursive", text:"Étrave profilée : elle fend l'air d'une entrée atmosphérique et porte le bouclier d'ablation."),
 (id:"hull_truss", name:"Treillis structurel", kind:"hull", mass:400.0, volume:0.0, hab_m3:0.0, hp:300.0, materials:[("steel",150.0), ("aluminium_alloy",60.0)], labor:8.0, ports:63, slots:[(External,2)], aero_area:6.0, text:"Poutrelles nues : léger et bon marché, mais sans air ni passage. Parfait pour écarter les masses."),
