// Geology of the solid worlds (see crates/world/src/geology.rs, which owns the numbers: the codex
// reads them from there). group: limite (plate boundary), roche, gisement (ore body), volcan,
// erosion, relief. yields: what a deposit gives, as (resource id, share), shares add up to 1;
// they feed the ground of a colony founded near it (crates/sim/src/geo.rs).
[
 // ---- plate boundaries -------------------------------------------------------------------
 (id:"convergent", name:"Frontière convergente", group:"limite", yields:[],
  text:"Deux plaques se poussent. Entre deux continents elles plissent une chaîne de montagnes ; si l'une est océanique elle plonge sous l'autre (subduction) : fosse profonde d'un côté, arc volcanique de l'autre. Les roches broyées se métamorphisent et les fluides chauds déposent des veines de métaux."),
 (id:"divergent", name:"Frontière divergente", group:"limite", yields:[],
  text:"Deux plaques s'écartent. Sous la mer c'est une dorsale où le manteau remonte et où les sources chaudes déposent des sulfures ; sur un continent c'est un fossé d'effondrement (rift) bordé de volcans."),
 (id:"transform", name:"Frontière transformante", group:"limite", yields:[],
  text:"Deux plaques coulissent l'une contre l'autre : aucun relief neuf, mais une faille où la contrainte s'accumule puis cède d'un coup. C'est là que frappent les séismes."),
 // ---- rocks ------------------------------------------------------------------------------
 (id:"igneous", name:"Roche ignée", group:"roche", yields:[],
  text:"Roche née du magma refroidi : basalte des fonds marins et des volcans, granite des vieux cœurs de continents. Dure, compacte, elle abrite les pipes de kimberlite."),
 (id:"sedimentary", name:"Roche sédimentaire", group:"roche", yields:[],
  text:"Ce que l'érosion a arraché aux montagnes et déposé dans les bassins et sur les plateaux continentaux, couche après couche. Elle garde les évaporites et, sur les mondes qui ont connu la vie, le pétrole et le gaz."),
 (id:"metamorphic", name:"Roche métamorphique", group:"roche", yields:[],
  text:"Roche cuite et comprimée au cœur des chaînes de montagnes sans avoir fondu : schistes, gneiss, marbres. Les veines métalliques et les pegmatites s'y logent."),
 // ---- ore bodies ---------------------------------------------------------------------------
 (id:"metal_vein", name:"Veine métallique", group:"gisement",
  yields:[("copper",0.30),("zinc",0.20),("silver",0.15),("gold",0.10),("nickel",0.10),("iron",0.15)],
  text:"Des fluides chauds remontent le long des chaînes de montagnes et des arcs volcaniques et déposent cuivre, zinc, argent et or dans les fractures."),
 (id:"hydrothermal", name:"Sulfures hydrothermaux", group:"gisement",
  yields:[("sulfur",0.35),("iron",0.25),("zinc",0.15),("copper",0.15),("cobalt",0.10)],
  text:"Autour des fumeurs noirs des dorsales, l'eau surchauffée dépose des sulfures de fer, de cuivre et de zinc, et du soufre natif."),
 (id:"kimberlite", name:"Pipe de kimberlite", group:"gisement",
  yields:[("diamond",0.30),("graphite",0.30),("carbon",0.20),("magnesium",0.20)],
  text:"Une cheminée de roche ultrabasique qui a remonté du manteau profond en emportant des diamants. On ne la trouve que dans le cœur ancien et stable d'un continent, loin de toute frontière de plaques."),
 (id:"evaporite", name:"Évaporites", group:"gisement",
  yields:[("salts",0.55),("lithium",0.15),("phosphorus",0.10),("sulfur",0.10),("magnesium",0.10)],
  text:"Une mer intérieure qui s'est asséchée a laissé sel, gypse, lithium et phosphates dans le fond d'un bassin aride."),
 (id:"petroleum", name:"Bassin pétrolier", group:"gisement",
  yields:[("organics",0.40),("methane",0.30),("carbon",0.20),("sulfur",0.10)],
  text:"Des sédiments riches en restes vivants, enfouis et cuits pendant des centaines de millions d'années : pétrole et gaz. Seuls les mondes qui ont porté une biosphère en ont."),
 (id:"pegmatite", name:"Pegmatite", group:"gisement",
  yields:[("lithium",0.30),("rare_earths",0.30),("uranium",0.15),("thorium",0.10),("silicon",0.15)],
  text:"Les dernières poches de magma granitique, riches en éléments rares, cristallisent en filons géants sur la bordure des chaînes de montagnes."),
 (id:"ice_field", name:"Champ de glace", group:"gisement",
  yields:[("water_ice",0.80),("co2_ice",0.10),("ammonia",0.05),("methane",0.05)],
  text:"Glace de surface des terres froides, calottes et glaciers : de l'eau, du carburant et de l'oxygène pour qui sait la fondre."),
 // ---- volcanoes -----------------------------------------------------------------------------
 (id:"arc", name:"Volcan d'arc", group:"volcan", yields:[],
  text:"Au-dessus d'une plaque qui plonge, la fusion du manteau nourrit une ligne de volcans explosifs parallèle à la fosse : anneaux de feu."),
 (id:"hotspot", name:"Point chaud", group:"volcan", yields:[],
  text:"Un panache du manteau perce la plaque qui dérive au-dessus de lui et laisse derrière lui une chaîne de volcans de plus en plus anciens, éteints et érodés (Hawaï, Olympus Mons sur un monde à couvercle figé)."),
 (id:"rift", name:"Volcan de rift", group:"volcan", yields:[],
  text:"Là où la croûte s'amincit sur une frontière divergente, le magma affleure en coulées fluides le long du fossé."),
 // ---- erosion -----------------------------------------------------------------------------
 (id:"hydraulic", name:"Érosion hydraulique", group:"erosion", yields:[],
  text:"La pluie et les cours d'eau arrachent la roche aux sommets et la déposent en aval : plus le monde est humide et vieux, plus ses montagnes sont basses et ses bassins épais de sédiments."),
 (id:"wind", name:"Érosion éolienne", group:"erosion", yields:[],
  text:"Sur les mondes secs avec une atmosphère, le vent lime les reliefs et entasse sable et poussières dans les dépressions."),
 (id:"glacial", name:"Érosion glaciaire", group:"erosion", yields:[],
  text:"Aux hautes latitudes les glaciers rabotent les vallées en U et arrondissent les sommets."),
 // ---- relief ----------------------------------------------------------------------------------
 (id:"mountain_range", name:"Chaîne de montagnes", group:"relief", yields:[],
  text:"Le relief naît d'une collision de plaques puis s'use : jeune elle est haute et escarpée, vieille elle est usée et arrondie. Les cartes des mondes sont tirées de ces plaques, pas d'un simple bruit."),
 (id:"trench", name:"Fosse océanique", group:"relief", yields:[],
  text:"Le point le plus profond d'un monde : là où une plaque océanique plonge sous une autre."),
 (id:"mid_ocean_ridge", name:"Dorsale océanique", group:"relief", yields:[],
  text:"Une chaîne sous-marine longue de milliers de kilomètres où naît la croûte neuve, entaillée d'un fossé central et criblée de sources chaudes."),
 (id:"rift_valley", name:"Fossé d'effondrement", group:"relief", yields:[],
  text:"Une plaine étroite et profonde qui s'enfonce là où un continent se déchire en deux."),
]
