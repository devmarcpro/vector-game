 (id:"cristal_poli", yields:[("silicon",1.0,0.5)], under:"roche_nue", name:"Cristal poli", kind:"floor", glyphs:".`", color:0x004090B0, pattern:"lisse", hardness:0.6, ground_of:[],
  text:"Facettes qui renvoient la lumière."),
 (id:"cristal", yields:[("silicon",3.0,0.8), ("diamond",0.1,0.05)], under:"cristal_poli", name:"Cristal brut", kind:"wall", glyphs:"#<>", color:0x0060B0D0, pattern:"lisse", hardness:0.7, ground_of:[],
