// World events that move prices (E-bourse). scope "region": a 60 light-year cell of space, each
// with its own events; scope "global": felt everywhere. weight: relative frequency. days: duration
// range. effects: (resource id or "cat:<category>", price multiplier at the peak of the event).
// Events fade in over the first fifth of their life and out over the last third.
[
 (id:"guerre", name:"Guerre de frontières", scope:"region", weight:1.0, days:(20.0,60.0), effects:[("cat:ammo",1.6),("fuel",1.4),("steel",1.25),("medicine",1.5),("food",1.2),("luxury_goods",0.8)], text:"Des flottes se déploient aux frontières : munitions, carburant et soins s'arrachent."),
 (id:"famine", name:"Famine", scope:"region", weight:0.8, days:(15.0,45.0), effects:[("food",1.8),("water",1.3),("medicine",1.2)], text:"Les récoltes ont échoué, les rations se vendent à prix d'or."),
 (id:"recolte", name:"Récolte exceptionnelle", scope:"region", weight:1.0, days:(20.0,40.0), effects:[("food",0.65),("fertilizer",0.9)], text:"Les silos débordent, la nourriture ne vaut presque plus rien."),
 (id:"greve", name:"Grève des mines", scope:"region", weight:0.9, days:(10.0,30.0), effects:[("cat:metal",1.3)], text:"Les mineurs ont posé leurs outils : les métaux se raréfient."),
 (id:"gisement", name:"Nouveau gisement", scope:"region", weight:0.8, days:(30.0,70.0), effects:[("cat:metal",0.78)], text:"Un riche filon est exploité : les métaux se bradent."),
 (id:"boom_tech", name:"Boom technologique", scope:"region", weight:0.8, days:(30.0,60.0), effects:[("electronics",1.35),("circuits",1.35),("robotics",1.3),("rare_earths",1.25),("solar_cells",1.2)], text:"Une vague d'innovation fait monter l'électronique."),
 (id:"epidemie", name:"Épidémie", scope:"region", weight:0.7, days:(20.0,50.0), effects:[("medicine",2.2),("food",1.1),("consumer_goods",0.85),("luxury_goods",0.8)], text:"Une maladie se propage : les médicaments sont introuvables."),
 (id:"crise_energie", name:"Crise de l'énergie", scope:"region", weight:0.7, days:(15.0,40.0), effects:[("fuel",1.7),("uranium",1.4),("thorium",1.3),("solar_cells",1.3),("batteries",1.25),("fuel_rods",1.4)], text:"Les centrales tournent au ralenti : tout ce qui produit de l'énergie flambe."),
 (id:"piraterie", name:"Vague de piraterie", scope:"region", weight:0.9, days:(15.0,40.0), effects:[("weapon_parts",1.3),("cat:ammo",1.3),("hull_plates",1.2),("luxury_goods",1.1)], text:"Les convois se font attaquer : armes et blindages se vendent bien."),
 (id:"fete", name:"Grandes fêtes", scope:"region", weight:0.8, days:(7.0,20.0), effects:[("luxury_goods",1.4),("consumer_goods",1.2),("food",1.1)], text:"Les stations célèbrent : le luxe est à la fête."),
 (id:"construction", name:"Boom de la construction", scope:"region", weight:0.9, days:(25.0,60.0), effects:[("construction_materials",1.3),("steel",1.25),("polymers",1.2),("glass",1.15),("machinery",1.2)], text:"Chantiers partout : les matériaux de construction manquent."),
 (id:"penurie_puces", name:"Pénurie de composants", scope:"region", weight:0.6, days:(20.0,50.0), effects:[("circuits",1.5),("electronics",1.3),("robotics",1.2)], text:"Une usine de composants est à l'arrêt."),
 (id:"embargo", name:"Embargo", scope:"region", weight:0.5, days:(20.0,60.0), effects:[("weapon_parts",1.5),("titanium_alloy",1.3),("luxury_goods",1.3)], text:"Des sanctions bloquent les échanges d'armes et d'alliages."),
 (id:"percee", name:"Percée scientifique", scope:"region", weight:0.5, days:(15.0,40.0), effects:[("research_data",1.5),("nanomaterials",1.3)], text:"Une découverte relance la demande de données et de matériaux avancés."),
 (id:"catastrophe", name:"Catastrophe naturelle", scope:"region", weight:0.6, days:(10.0,30.0), effects:[("construction_materials",1.4),("food",1.3),("medicine",1.4),("water",1.3),("machinery",1.15)], text:"Séismes et tempêtes ravagent les colonies : il faut tout reconstruire."),
 (id:"krach", name:"Krach boursier", scope:"global", weight:0.5, days:(20.0,45.0), effects:[("luxury_goods",0.7),("consumer_goods",0.85),("robotics",0.85),("gold",1.2),("platinum",1.15)], text:"Les marchés s'effondrent ; les valeurs refuges grimpent."),
 (id:"tempete_solaire", name:"Tempête solaire majeure", scope:"global", weight:0.4, days:(5.0,12.0), effects:[("electronics",1.25),("circuits",1.3),("solar_cells",0.85)], text:"Les électroniques grillent partout, il faut les remplacer."),
 (id:"ruee", name:"Ruée vers l'or", scope:"global", weight:0.5, days:(20.0,40.0), effects:[("gold",0.8),("silver",0.9),("tools",1.2)], text:"Tout le monde prospecte : l'or abonde, les outils manquent."),
 (id:"inflation", name:"Inflation galactique", scope:"global", weight:0.4, days:(40.0,90.0), effects:[("cat:metal",1.1),("cat:consumable",1.1)], text:"Les prix dérivent lentement vers le haut."),
 (id:"artefacts", name:"Artefacts sur le marché", scope:"global", weight:0.3, days:(15.0,30.0), effects:[("artifacts",0.6)], text:"Une cache ancienne inonde le marché de reliques."),
 (id:"penurie_helium", name:"Pénurie d'hélium-3", scope:"global", weight:0.4, days:(20.0,50.0), effects:[("helium3",1.6),("deuterium",1.3)], text:"Les géantes gazeuses sont moins exploitées : le combustible de fusion se raréfie."),
]
