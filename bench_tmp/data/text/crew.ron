// Text templates by key. Placeholders: {a} {b} {role} {n} {amount} {disease}. One is chosen per use.
[
 ("hire", ["{a} rejoint l'equipage comme {role}.", "{a} monte a bord, sac sur l'epaule : nouveau {role}.", "Bienvenue a {a}, qui prend le poste de {role}."]),
 ("dismiss", ["{a} quitte le vaisseau.", "{a} est debarque a la prochaine escale."]),
 ("death", ["{a} est mort a bord. Le silence se fait dans la coursive.", "{a} n'a pas survecu. L'equipage se recueille.", "On a perdu {a}. Personne ne parle pendant des heures."]),
 ("sick", ["{a} est atteint de {disease}.", "{a} se sent mal : {disease}."]),
 ("healed", ["{a} est gueri de {disease}.", "{a} se remet enfin de {disease}."]),
 ("hungry", ["L'equipage a faim : les rations sont epuisees.", "Plus de nourriture en soute !"]),
 ("thirsty", ["Les reserves d'eau sont a sec.", "Plus d'eau potable a bord."]),
 ("air", ["L'air devient irrespirable : le support de vie est en panne.", "Alerte atmosphere : la qualite de l'air chute."]),
 ("unpaid", ["Les salaires n'ont pas pu etre verses ; l'equipage murmure.", "Salaires impayes : la loyaute s'effrite."]),
 ("paid", ["Salaires verses : {amount} credits.", "Paie du jour : {amount} credits."]),
 ("repair", ["{a} remet un module en etat.", "{a} passe la nuit a reparer les systemes."]),
 ("quit", ["{a} a quitte le bord.", "{a} a pris le large a la premiere occasion."]),
]
