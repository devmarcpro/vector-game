// Incidents of the companies (read by crates/sim/src/incidents.rs). One of them strikes a
// company in a sector now and then. share: effect on the share price at full strength (and,
// opposite, on the price of the company's goods in that sector). text: the headline; {c} the
// company, {p} the place. The order is part of the draw: append, do not reorder.
[
 (id:"convoi_capture", share:-0.12, text:"Le convoi de {c} a ete capture par des pirates pres de {p}."),
 (id:"greve", share:-0.07, text:"Greve generale chez {c} a {p} : les chaines de production sont a l'arret."),
 (id:"benefices", share:0.09, text:"{c} annonce des benefices records pour son comptoir de {p}."),
 (id:"scandale", share:-0.15, text:"Scandale comptable chez {c} a {p} : le directeur local demissionne."),
 (id:"contrat_militaire", share:0.10, text:"{c} decroche un contrat militaire majeur a {p}."),
 (id:"incendie", share:-0.06, text:"Un entrepot de {c} a {p} est detruit par un incendie."),
]
