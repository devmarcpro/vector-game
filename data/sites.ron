// Sites of interest met on expeditions (E5). Placed 2 to 4 per map by weight, away from the
// landing point; G next to one searches it once. loot: (resource id, kg); danger: chance
// (0..1) of an ambush or a collapse that wounds the searcher; heal: mends the whole party.
[
 (id:"campement", name:"Campement abandonné", glyph:"c", color:0x00E0C060, weight:4.0,
  loot:[("spare_parts",6.0),("food",8.0),("electronics",2.0)], danger:0.05, heal:false,
  text:"Des tentes déchirées, un réchaud encore tiède : quelqu'un est parti en hâte."),
 (id:"epave", name:"Épave d'atterrisseur", glyph:"W", color:0x00C0C8D0, weight:3.0,
  loot:[("steel",30.0),("electronics",5.0),("spare_parts",10.0)], danger:0.15, heal:false,
  text:"La coque fendue d'un petit engin, couverte de poussière et de lichen."),
 (id:"ruine", name:"Ruine ancienne", glyph:"R", color:0x00C080E0, weight:1.0,
  loot:[("artifacts",1.0),("research_data",3.0)], danger:0.25, heal:false,
  text:"Des murs d'un matériau inconnu, gravés de signes que personne ne sait lire."),
 (id:"grotte", name:"Entrée de grotte", glyph:"O", color:0x00A0A0A0, weight:3.0,
  loot:[("iron",50.0),("nickel",12.0),("copper",8.0)], danger:0.3, heal:false,
  text:"Une gueule sombre dans la roche, aux parois veinées de métal."),
 (id:"source", name:"Source chaude", glyph:"S", color:0x0060C0FF, weight:2.0,
  loot:[("water",30.0)], danger:0.0, heal:true,
  text:"Une eau limpide et tiède qui fume dans l'air froid : l'équipe s'y repose."),
 (id:"balise", name:"Balise de détresse", glyph:"!", color:0x00FF8040, weight:2.0,
  loot:[("research_data",5.0),("electronics",3.0)], danger:0.0, heal:false,
  text:"Un émetteur qui répète le même appel depuis des années."),
]
