// Exotic physics and advanced civilisations (high science fiction).
// kind: "matter" | "propulsion" | "field" | "entity" | "precursor" | "fermi".
// danger 0..1: damage scale when the phenomenon is studied badly; research / credits: reward
// ranges; loot: (resource id, min kg, max kg). "fermi" entries are the possible answers to the
// Fermi paradox: the galaxy seed picks the one that is true; precursor ruins hold the clues.
[
 (id:"antimatter_pocket", name:"Poche d'antimatiere", kind:"matter", danger:0.8, research:(60.0,140.0), credits:(0.0,2000.0), loot:[("antimatter",0.0005,0.004)],
  text:"Des antiparticules piegees dans un champ naturel. Chaque gramme libere deux fois m c2 au contact de la matiere."),
 (id:"dark_halo", name:"Halo de matiere noire", kind:"matter", danger:0.2, research:(80.0,180.0), credits:(0.0,500.0), loot:[("dark_matter",0.5,3.0)],
  text:"Une masse invisible courbe la lumiere et les trajectoires sans rien emettre. Seule la gravite la trahit."),
 (id:"exotic_throat", name:"Gorge de matiere exotique", kind:"matter", danger:0.5, research:(90.0,200.0), credits:(0.0,3000.0), loot:[("exotic_matter",0.1,1.5)],
  text:"Une matiere de masse negative maintient ouverte une gorge de ver. Stabilisee, elle devient un passage."),
 (id:"warp_wake", name:"Sillage d'une bulle de distorsion", kind:"propulsion", danger:0.4, research:(70.0,160.0), credits:(0.0,1000.0), loot:[("exotic_matter",0.05,0.4)],
  text:"Une bulle d'Alcubierre est passee ici il y a longtemps : l'espace garde la cicatrice de sa compression."),
 (id:"orion_hulk", name:"Epave de vaisseau Orion", kind:"propulsion", danger:0.3, research:(30.0,80.0), credits:(1000.0,9000.0), loot:[("uranium",50.0,400.0)],
  text:"Une plaque de poussee ravinee par des milliers de charges nucleaires. Rustique, brutale, efficace."),
 (id:"cosmic_string", name:"Corde cosmique", kind:"field", danger:0.6, research:(100.0,220.0), credits:(0.0,800.0), loot:[],
  text:"Un defaut lineaire de l'espace-temps, plus fin qu'un proton et plus lourd qu'une montagne par metre. Le temps s'y deforme."),
 (id:"naked_singularity", name:"Singularite nue", kind:"field", danger:0.95, research:(150.0,320.0), credits:(0.0,500.0), loot:[],
  text:"Aucun horizon ne cache la singularite : les lois de la physique y cessent d'etre calculables."),
 (id:"monopole_swarm", name:"Essaim de monopoles", kind:"matter", danger:0.35, research:(80.0,170.0), credits:(0.0,2500.0), loot:[("exotic_matter",0.02,0.2)],
  text:"Des charges magnetiques isolees, relique du tout premier instant. Elles catalysent la decomposition des protons."),
 (id:"strangelet_seed", name:"Graine de strangelet", kind:"matter", danger:0.9, research:(110.0,240.0), credits:(0.0,600.0), loot:[],
  text:"Un fragment de matiere etrange convertit la matiere ordinaire qu'il touche. Sur une planete, ce serait la fin."),
 (id:"stasis_vault", name:"Chambre de stase ancienne", kind:"field", danger:0.25, research:(70.0,150.0), credits:(2000.0,12000.0), loot:[("artifacts",1.0,6.0)],
  text:"Un champ fige le temps a l'interieur : ce qui dort la attend depuis des millions d'annees."),
 (id:"nano_bloom", name:"Floraison de nanites", kind:"entity", danger:0.7, research:(90.0,200.0), credits:(0.0,1500.0), loot:[("nanites",0.2,2.0)],
  text:"Un essaim auto-replicant a transforme un asteroide en lui-meme. Il reconnait la matiere comme un menu."),
 (id:"hive_mind", name:"Intelligence collective", kind:"entity", danger:0.3, research:(100.0,230.0), credits:(0.0,4000.0), loot:[],
  text:"Mille esprits, une pensee. Elle cherche a vous comprendre ; la premiere rencontre decidera de tout."),
 (id:"post_human_ark", name:"Arche de post-humains", kind:"entity", danger:0.2, research:(120.0,260.0), credits:(3000.0,20000.0), loot:[("artifacts",1.0,4.0)],
  text:"Des descendants de l'humanite, reecrits en logiciel et en lumiere. Ils parlent peu, et de choses lointaines."),
 (id:"nonlocal_entity", name:"Entite non locale", kind:"entity", danger:0.55, research:(130.0,300.0), credits:(0.0,0.0), loot:[],
  text:"Elle n'est nulle part en particulier. Sa reponse arrive parfois avant votre question."),
 (id:"ringworld_fragment", name:"Fragment d'anneau-monde", kind:"precursor", danger:0.15, research:(150.0,300.0), credits:(5000.0,30000.0), loot:[("artifacts",2.0,8.0),("iron",200.0,900.0)],
  text:"Un arc de matiere ordonnee large comme un continent. Les anciens construisaient a l'echelle des etoiles."),
 (id:"dyson_swarm", name:"Essaim de Dyson abandonne", kind:"precursor", danger:0.2, research:(140.0,280.0), credits:(4000.0,25000.0), loot:[("artifacts",1.0,6.0)],
  text:"Des millions de capteurs enveloppent l'etoile. Une civilisation de type II a vecu ici ; elle n'a pas laisse d'adresse."),
 (id:"precursor_archive", name:"Archive des anciens", kind:"precursor", danger:0.1, research:(160.0,340.0), credits:(2000.0,15000.0), loot:[("artifacts",1.0,5.0)],
  text:"Un reseau de cristaux garde la memoire d'un peuple. Il contient des indices sur ce qui est arrive aux autres."),
 (id:"fermi_answer_filter", name:"Le grand filtre", kind:"fermi", danger:0.0, research:(0.0,0.0), credits:(0.0,0.0), loot:[],
  text:"Presque toute vie meurt avant de voyager : une barriere universelle, deja franchie ou encore a venir."),
 (id:"fermi_answer_zoo", name:"L'hypothese du zoo", kind:"fermi", danger:0.0, research:(0.0,0.0), credits:(0.0,0.0), loot:[],
  text:"Ils sont la, et ils nous laissent seuls expres. Ce que vous croyez etre le silence est une reserve naturelle."),
 (id:"fermi_answer_dark", name:"La foret sombre", kind:"fermi", danger:0.0, research:(0.0,0.0), credits:(0.0,0.0), loot:[],
  text:"Chacun se tait, car tout ce qui parle est detruit par plus fort. Les anciens n'ont pas disparu : ils se cachent."),
 (id:"fermi_answer_transcend", name:"La transcendance", kind:"fermi", danger:0.0, research:(0.0,0.0), credits:(0.0,0.0), loot:[],
  text:"Les civilisations avancees quittent l'univers visible, vers un autre etat, une autre dimension. Il ne reste que des ruines."),
 (id:"fermi_answer_rare", name:"La rarete", kind:"fermi", danger:0.0, research:(0.0,0.0), credits:(0.0,0.0), loot:[],
  text:"La vie complexe est si improbable qu'elle n'est apparue qu'une fois par galaxie. Vous etes peut-etre le premier regard."),
 (id:"fermi_answer_machines", name:"La releve des machines", kind:"fermi", danger:0.0, research:(0.0,0.0), credits:(0.0,0.0), loot:[],
  text:"Les createurs ont ete remplaces par leurs intelligences artificielles, qui n'ont aucune raison de communiquer avec la biologie."),
]
